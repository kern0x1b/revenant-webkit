# =============================================================================
# Object build statements for STATIC_LIBRARY target capstone


#############################################
# Order-only phony target for capstone

build cmake_object_order_depends_target_capstone: phony || Source/ThirdParty/capstone/CMakeFiles/capstone.dir

build Source/ThirdParty/capstone/CMakeFiles/capstone.dir/Source/cs.c.o: C_COMPILER__capstone_Release /src/Source/ThirdParty/capstone/Source/cs.c || cmake_object_order_depends_target_capstone
  DEFINES = -DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DCAPSTONE_HAS_ARM -DCAPSTONE_USE_SYS_DYN_MEM -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -D_GLIBCXX_ASSERTIONS=1
  DEP_FILE = Source/ThirdParty/capstone/CMakeFiles/capstone.dir/Source/cs.c.o.d
  FLAGS = -fdiagnostics-color=always -Wextra -Wall -pipe -fmax-errors=20 -Wno-stringop-overflow -Wno-expansion-to-defined -fno-unswitch-loops -Wno-maybe-uninitialized -Wno-psabi -Wno-misleading-indentation -Wundef -Wpointer-arith -Wmissing-format-attribute -Wformat-security -Wno-tautological-compare -fno-strict-aliasing -fno-exceptions  -mthumb -ffunction-sections -fdata-sections -O3 -DNDEBUG -fPIC -fvisibility=hidden -Wno-sign-compare -Wno-unused-parameter -Wno-ignored-qualifiers -Wno-implicit-fallthrough -Wno-missing-field-initializers -Wno-missing-format-attribute -Wno-discarded-qualifiers -Wno-cast-align
  INCLUDES = -I/src/Source/ThirdParty/capstone/Source/include
  OBJECT_DIR = Source/ThirdParty/capstone/CMakeFiles/capstone.dir
  OBJECT_FILE_DIR = Source/ThirdParty/capstone/CMakeFiles/capstone.dir/Source
  TARGET_COMPILE_PDB = Source/ThirdParty/capstone/CMakeFiles/capstone.dir/capstone.pdb
  TARGET_PDB = lib/libcapstone.pdb

build Source/ThirdParty/capstone/CMakeFiles/capstone.dir/Source/Mapping.c.o: C_COMPILER__capstone_Release /src/Source/ThirdParty/capstone/Source/Mapping.c || cmake_object_order_depends_target_capstone
  DEFINES = -DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DCAPSTONE_HAS_ARM -DCAPSTONE_USE_SYS_DYN_MEM -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -D_GLIBCXX_ASSERTIONS=1
