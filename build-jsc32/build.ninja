  restat = 1

build Source/JavaScriptCore/test: phony Source/JavaScriptCore/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build Source/JavaScriptCore/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /build/Source/JavaScriptCore && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
