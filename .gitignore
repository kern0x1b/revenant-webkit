# Upstream checkouts. Only webkit-254 is tracked, as a real git submodule
# pointing at the ios6-armv7 branch of kern0x1b/WebKit — see .gitmodules.
# The others are still fetched by fetch-source.sh and stay untracked.
webkit-603/
webkit-trunk/
webkit-trunk-jit/

# Dependencies built from source by the build-*.sh scripts.
third_party
third_party/

# Build trees. Every one of these is reproducible from configure-*.sh plus
# build-*.sh, and together they are several gigabytes.
/build/
build-254*/
build-cocoa/
build-icu-armv7/
build-icu-host/
build-jit/
build-jsc/
build-libcxx/
build-trunk/

# Products: the staged application and object files.
dist/
out/
*.log
*.o
*.a
*.dylib
*.tar
*.tar.gz

.DS_Store
# The device's address and password. device.env.example is the tracked template;
# every other variant, including hand-kept backups, is personal.
device.env*
!device.env.example

# Local device screenshots captured during work — may show device content
.claude/screenshots/
.theos/
packaging/packages/
packaging/obj/
# Theos leaves a .stamp beside sources it reaches through a relative path.
packaging/**/.stamp
sweep-shots/
build-254-angle/

# A sweep list is the operator's, never the repository's.
tests/device/sweep-sites.txt
