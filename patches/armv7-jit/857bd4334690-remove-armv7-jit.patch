-        if (node->op() == PutByValDirectResolved) {
-            // Store the value to the array.
-            GPRReg propertyReg = property.gpr();
-            storeValue(valueRegs, BaseIndex(storageReg, propertyReg, TimesEight, ArrayStorage::vectorOffset()));
