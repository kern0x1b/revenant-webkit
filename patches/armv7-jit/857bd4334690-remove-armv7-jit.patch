-    arg1.use();
-    arg2.use();
-
-    if (isKnownCell(node->child1().node()) && isKnownCell(node->child2().node())) {
-        // see if we get lucky: if the arguments are cells and they reference the same
-        // cell, then they must be strictly equal.
