+        storeASCIIWord(output + index + 4, second);
+        storeASCIIWord(output + index + 8, third);
+        storeASCIIWord(output + index + 12, fourth);
+        index += 16;
+    }
+    while (size - index >= 4) {
+        uint32_t word = WTF::unalignedLoad<uint32_t>(input + index);
