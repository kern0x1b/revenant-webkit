+            } else if (classInfo->isSubClassOf(ScriptExecutable::info())) {
+                statistics.executableCount++;
+                statistics.sourceBytes += jsCell->estimatedSizeInBytes(vm);
+            }
+            return IterationStatus::Continue;
+        });
