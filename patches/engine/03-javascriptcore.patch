+                statistics.unlinkedCodeBlockCount++;
+                statistics.unlinkedCodeBlockBytes += jsCell->estimatedSizeInBytes(vm);
+            } else if (classInfo->isSubClassOf(CodeBlock::info())) {
+                statistics.codeBlockCount++;
