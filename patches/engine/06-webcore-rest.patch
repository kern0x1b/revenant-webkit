+            return static_cast<T>(boxed);
+        else if (static_cast<uint32_t>(boxed) <= static_cast<uint32_t>(std::numeric_limits<T>::max()))
+            return static_cast<T>(boxed);
+    }
+
+    return std::nullopt;
