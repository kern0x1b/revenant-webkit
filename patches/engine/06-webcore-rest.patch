+template<typename IDL> ALWAYS_INLINE std::optional<typename IDL::ImplementationType> fastConvertBoxedInt32(JSC::JSValue value)
+{
+    using T = typename IDL::ImplementationType;
+    static_assert(std::is_integral_v<T>);
